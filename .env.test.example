# Settings for automated tests. Playwright (playwright.config.ts) sets the
# TEST ONLY ones itself; the rest come from .env.local. Never set the TEST ONLY
# variables in production.

# Real keys are only needed for `npm run eval:bot` and `npm run eval:voice`
# (tests never call an AI or Meta).
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_TRANSCRIBE_API_KEY=

# TEST ONLY
WHATSAPP_GRAPH_BASE_URL=http://localhost:3999
BOT_FAKE_AI=1
# The fake transcription returns this text (default below).
BOT_FAKE_TRANSCRIPT=2 zinger burger aur ek coke
# Bot playground + voice tests on a production test build.
ENABLE_DEV_TOOLS=1
