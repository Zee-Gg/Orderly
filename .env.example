# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of the app (no trailing slash). Used in auth emails, and by the WhatsApp bot
# for the customer menu link (/m/<slug>) — set it to your ngrok URL when testing on a phone.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# WhatsApp Cloud API (server-only)
# Meta App > App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=
# 32 random bytes as 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts WhatsApp access tokens. Changing it makes saved tokens unreadable (reconnect numbers).
TOKEN_ENCRYPTION_KEY=

# AI order bot (server-only). AI_PROVIDER = google | anthropic | groq.
# Only the active provider's key is needed. Free tiers are rate limited.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# Optional model override per provider (defaults in src/lib/bot/config.ts):
# BOT_MODEL_GOOGLE=gemini-3.5-flash-lite
# BOT_MODEL_ANTHROPIC=claude-haiku-5-5
# BOT_MODEL_GROQ=llama-3.3-70b-versatile

# Voice notes (server-only). TRANSCRIBE_PROVIDER = groq (default) | google.
# groq: Whisper on Groq (optional: without GROQ_API_KEY voice falls back to google).
# google: Gemini with audio; uses GOOGLE_TRANSCRIBE_API_KEY, else the chat key above.
TRANSCRIBE_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_TRANSCRIBE_API_KEY=
# Optional model overrides (defaults in src/lib/bot/config.ts):
# TRANSCRIBE_MODEL_GROQ=whisper-large-v3
# TRANSCRIBE_MODEL_GOOGLE=gemini-3.5-flash-lite

# TEST ONLY: send Graph API calls to a fake server (Playwright sets this).
# Never set it in production.
# WHATSAPP_GRAPH_BASE_URL=http://localhost:3999
# TEST ONLY: rule-based fake AI instead of a real provider (Playwright sets this). Never in production.
# BOT_FAKE_AI=1
