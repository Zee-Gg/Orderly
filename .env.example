# =============================================================================
# Orderly environment variables
# Copy to .env.local for development. In production set them in Vercel →
# Project → Settings → Environment Variables (Production).
#
#   [REQUIRED]  must be set in production
#   [OPTIONAL]  works without it
#   [DEV/TEST]  never set in production
#
# ONE Supabase project is used for development AND production. Anything that
# writes demo data is blocked unless ALLOW_DEMO_DATA=true (see below).
# Never prefix a secret with NEXT_PUBLIC_ — those are sent to the browser.
# =============================================================================

# --- Supabase (Project Settings → API Keys) ----------------------------------
# [REQUIRED] Public, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [REQUIRED] SECRET, server only (bypasses RLS).
SUPABASE_SECRET_KEY=

# --- App URL -----------------------------------------------------------------
# [REQUIRED] Public URL, no trailing slash. Auth emails, menu links the bot sends.
# Development with a phone: your ngrok URL. Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# --- WhatsApp Cloud API (server only) ----------------------------------------
# [REQUIRED] Meta App → App settings → Basic → App secret (verifies webhook signatures).
WHATSAPP_APP_SECRET=
# [REQUIRED] Any long random string; paste the same value as Meta's webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=
# [REQUIRED] 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts WhatsApp access tokens (and keys rate-limit hashes). Changing it makes saved
# tokens unreadable — you would have to reconnect every number.
TOKEN_ENCRYPTION_KEY=

# --- AI order bot (server only) ----------------------------------------------
# [REQUIRED] google | anthropic | groq — plus THAT provider's key.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# [REQUIRED in production] Set to "paid" once the key above is on a PAID plan.
# Without it /admin/health shows a warning (free tiers rate-limit real restaurants).
# Also fill in the cost rates in src/lib/bot/config.ts (marked TODO BEFORE LAUNCH).
AI_PROVIDER_TIER=free
# [OPTIONAL] Model overrides (defaults in src/lib/bot/config.ts):
# BOT_MODEL_GOOGLE=gemini-3.5-flash-lite
# BOT_MODEL_ANTHROPIC=claude-haiku-5-5
# BOT_MODEL_GROQ=llama-3.3-70b-versatile

# --- Voice notes (server only) -----------------------------------------------
# [OPTIONAL] groq (default, Whisper) | google (Gemini audio).
TRANSCRIBE_PROVIDER=groq
# [OPTIONAL] Without GROQ_API_KEY voice notes use Google.
GROQ_API_KEY=
# [OPTIONAL] Separate Google key for transcription; else the chat key above.
GOOGLE_TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL_GROQ=whisper-large-v3
# TRANSCRIBE_MODEL_GOOGLE=gemini-3.5-flash-lite

# --- Scheduled jobs ----------------------------------------------------------
# [REQUIRED] Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/maintenance. Vercel sets the header automatically when this variable exists.
CRON_SECRET=

# --- Error tracking (Sentry, free tier) --------------------------------------
# [OPTIONAL, recommended] Sentry → Project → Client Keys (DSN). Off when empty.
# A DSN is not a secret; the browser one must start with NEXT_PUBLIC_.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Shared database safety ---------------------------------------------------
# [DEV/TEST] seed:menu, simulate:orders, whatsapp:fake and whatsapp:send-test
# refuse to run unless this is "true". They WRITE TO THE LIVE DATABASE.
# Set true only while testing BEFORE launch. Keep false after launch.
ALLOW_DEMO_DATA=false

# --- Test only: NEVER in production ------------------------------------------
# [DEV/TEST] Dev tools (bot playground, voice tests) on a production build (Playwright only).
# ENABLE_DEV_TOOLS=1
# [DEV/TEST] Send Graph API calls to a fake server (Playwright).
# WHATSAPP_GRAPH_BASE_URL=http://localhost:3999
# [DEV/TEST] Rule-based fake AI and fake transcripts instead of real providers.
# BOT_FAKE_AI=1
# BOT_FAKE_TRANSCRIPT=
