# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional. Public URL of the app, used in auth emails when the request has no Origin header.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# WhatsApp Cloud API (server-only)
# Meta App > App settings > Basic > App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=
# 32 random bytes as 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts WhatsApp access tokens. Changing it makes saved tokens unreadable (reconnect numbers).
TOKEN_ENCRYPTION_KEY=

# TEST ONLY: send Graph API calls to a fake server (Playwright sets this).
# Never set it in production.
# WHATSAPP_GRAPH_BASE_URL=http://localhost:3999
